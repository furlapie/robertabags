<div class="drawer" id="drawer" aria-hidden="true">
  <div class="drawer-overlay" data-close></div>
  <aside class="drawer-panel" role="dialog" aria-label="Borsa">
    <div class="drawer-head">
      <h2>La tua borsa</h2>
      <button class="drawer-close" data-close aria-label="Chiudi">✕</button>
    </div>
    <div class="drawer-body" id="drawer-body"></div>
    <div class="drawer-foot">
      <div class="drawer-total"><span>Subtotale</span><strong id="drawer-total">€ 0</strong></div>
      <p class="drawer-note">{{ site.shipping }}, calcolata al pagamento.</p>
      <button class="btn" id="checkout-btn">Vai al pagamento</button>
    </div>
  </aside>
</div>