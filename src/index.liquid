---
layout: base.liquid
---
<section class="hero reveal">
  <h1>Ogni borsa,<br>un tessuto <em>diverso</em>.</h1>
  <p class="lead">Borse cucite a mano a Milano, con stoffe che trovi solo qui.</p>
</section>

<section id="collezione" class="section collezione">
  <div class="grid">
    {% for model in products %}
      {% assign first = model.variants[0] %}
      {% assign inStock = model.variants | where_exp: "v", "v.stock > 0" | size %}
      <a class="card reveal" href="/borse/{{ model.slug }}/">
        <div class="card-img">
          <img src="{{ first.images[0] }}" alt="{{ model.name }}" loading="lazy" onerror="this.style.display='none'">
          {% if inStock == 0 %}<span class="tag">Esaurita</span>{% endif %}
        </div>
        <div class="card-meta">
          <h3>{{ model.name }}</h3>
          <p class="card-price">€ {{ model.price }}</p>
        </div>
        <div class="swatches">
          {% for v in model.variants %}<span class="dot" title="{{ v.name }}" data-img="{{ v.images[0] }}" data-color="{{ v.swatch }}" style="background:{{ v.swatch }}"></span>{% endfor %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>

<div class="ribbons" aria-hidden="true">
  <div class="ribbon ribbon-pink"><div class="ribbon-track">
    {% for i in (1..16) %}<span>Fatto a mano ✦ Pezzi limitati ✦ Tessuti scelti uno a uno ✦ </span>{% endfor %}
  </div></div>
  <div class="ribbon ribbon-glass"><div class="ribbon-track reverse">
    {% for i in (1..16) %}<span>Velluto ✦ Seta ✦ Broccato ✦ Cotone ✦ </span>{% endfor %}
  </div></div>
</div>

<section id="crea" class="section crea">
  <div class="cfg" id="cfg">
    <div class="cfg-stage" id="cfg-stage">
      <div class="cfg-bloom" id="cfg-bloom"></div>
      <div class="cfg-bag" id="cfg-bag"><div class="cfg-float" id="cfg-float"></div></div>
      <div class="cfg-label" id="cfg-label"></div>
      <div class="cfg-ref" id="cfg-ref"></div>
    </div>
    <div class="cfg-side">
      <div class="cfg-top">
        <h2>Crea la tua borsa</h2>
        <div class="cfg-price"><small>da</small><b id="cfg-pv">€ 0</b></div>
      </div>
      <div class="cfg-tabs" id="cfg-tabs"></div>
      <div class="cfg-body" id="cfg-body"></div>
      <div class="cfg-foot" id="cfg-foot">
        <button class="btn btn-ghost" id="cfg-prev" data-a="prev">Indietro</button>
        <button class="btn" id="cfg-next" data-a="next">Avanti</button>
      </div>
    </div>
  </div>
</section>

<script>window.PRODUCTS = {{ products | json }}; window.CFG_EMAIL = "{{ site.email }}";</script>